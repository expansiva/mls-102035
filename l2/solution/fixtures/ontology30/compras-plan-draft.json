      "toEntity": "ItemRecebimentoCompra",
      "type": "oneToMany",
      "required": true,
      "description": "O item do pedido pode ser recebido em uma ou mais etapas.",
      "persistence": {
        "mode": "moduleReference"
      }
    },
    {
      "relationshipId": "produtoComponeItensRecebimento",
