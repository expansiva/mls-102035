{
  "types": [
    {
      "name": "ParticipanteModulo",
      "description": "Usuário da organização que participa do módulo de tarefas, com sua situação, papéis, as marcas do gestor e as marcas efetivas de aceitar e criar tarefas.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.version"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.identification.status"
            ]
          }
        },
        {
          "name": "details.identification.tags",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.identification.tags"
            ]
          }
        },
        {
          "name": "details.tarefas.aceitaTarefas",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.tarefas.aceitaTarefas"
            ]
          }
        },
        {
          "name": "details.tarefas.podeCriarTarefas",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.tarefas.podeCriarTarefas"
            ]
          }
        },
        {
          "name": "details.tarefas.aceitaTarefasEfetivo",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.tarefas.aceitaTarefasEfetivo"
            ]
          }
        },
        {
          "name": "details.tarefas.podeCriarTarefasEfetivo",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.tarefas.podeCriarTarefasEfetivo"
            ]
          }
        }
      ]
    },
    {
      "name": "UsuarioOrganizacao",
      "description": "Usuário ativo da organização que ainda não participa do módulo de tarefas, identificado apenas pelo nome lido da plataforma.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.id"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.identification.status"
            ]
          }
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "listarParticipantes",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "participantes",
          "type": "ParticipanteModulo[]",
          "paginated": true
        }
      ],
      "rules": [
        "participanteNaoConfiguradoAceitaECria"
      ],
      "jsdoc": {
        "purpose": "Lista os participantes do módulo de tarefas da organização, com busca opcional pelo nome.",
        "input": "busca: trecho do nome do participante (opcional); page e pageSize: página pedida e tamanho da página.",
        "processing": "Localiza pelo papel tarefas.Participante os registros da organização, filtra pelo nome quando há busca e ordena pelo nome. Calcula aceitaTarefasEfetivo e podeCriarTarefasEfetivo pela regra participanteNaoConfiguradoAceitaECria: marca vazia vale sim; os campos efetivos são calculados, nunca gravados. Devolve só identificação e marcas do módulo, sem dado pessoal.",
        "output": "Página { items, page, pageSize, hasMore } de participantes com id, versão, nome, situação, papéis, marcas do gestor (vazias quando não configurado) e marcas efetivas."
      }
    },
    {
      "id": "buscarUsuarios",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "usuarios",
          "type": "UsuarioOrganizacao[]"
        }
      ],
      "rules": [
        "participanteSemCadastroPessoal"
      ],
      "jsdoc": {
        "purpose": "Busca pelo nome, entre os usuários da organização, quem pode ser incluído como participante.",
        "input": "busca: trecho do nome do usuário digitado pelo gestor.",
        "processing": "Consulta a lista de usuários da plataforma pelo nome, mantém apenas usuários ativos que ainda não têm o papel tarefas.Participante e limita o resultado aos primeiros encontrados. Pela regra participanteSemCadastroPessoal não lê nem devolve dado pessoal, apenas o nome.",
        "output": "Lista curta de usuários com id, nome e situação."
      }
    },
    {
      "id": "incluirParticipante",
      "kind": "cmd",
      "when": "incluirParticipante",
      "writes": "Participante.create",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.id"
            ]
          }
        },
        {
          "name": "details.tarefas.aceitaTarefas",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.tarefas.aceitaTarefas"
            ]
          }
        },
        {
          "name": "details.tarefas.podeCriarTarefas",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.tarefas.podeCriarTarefas"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "participante",
          "type": "ParticipanteModulo"
        }
      ],
      "rules": [
        "participanteSemCadastroPessoal",
        "participanteNaoConfiguradoAceitaECria",
        "escolhaGestorNuncaSobrescrita",
        "gestorPorAcessoPlataforma"
      ],
      "jsdoc": {
        "purpose": "Inclui um usuário da organização como participante do módulo de tarefas.",
        "input": "id: id do usuário escolhido na busca; details.tarefas.aceitaTarefas e details.tarefas.podeCriarTarefas: marcas opcionais do gestor, deixadas vazias quando não informadas.",
        "processing": "Verifica pelo acesso da plataforma que quem chama é gestor (gestorPorAcessoPlataforma). Marca o papel tarefas.Participante no registro do usuário e grava só o espaço do módulo, sem cadastrar pessoa nem pedir dado pessoal (participanteSemCadastroPessoal). Marcas não informadas ficam vazias e valem sim (participanteNaoConfiguradoAceitaECria); marcas já existentes do gestor não são sobrescritas automaticamente (escolhaGestorNuncaSobrescrita). Os campos efetivos são calculados na leitura.",
        "output": "O participante incluído, no novo estado, com versão, marcas do gestor e marcas efetivas."
      }
    },
    {
      "id": "salvarMarcas",
      "kind": "cmd",
      "when": "salvarMarcas",
      "writes": "Participante.update",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.version"
            ]
          }
        },
        {
          "name": "details.tarefas.aceitaTarefas",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.tarefas.aceitaTarefas"
            ]
          }
        },
        {
          "name": "details.tarefas.podeCriarTarefas",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.tarefas.podeCriarTarefas"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "participante",
          "type": "ParticipanteModulo"
        }
      ],
      "rules": [
        "escolhaGestorNuncaSobrescrita",
        "participanteNaoConfiguradoAceitaECria",
        "gestorPorAcessoPlataforma"
      ],
      "jsdoc": {
        "purpose": "Grava as marcas de aceitar tarefas e de poder criar tarefas de um participante.",
        "input": "id e version: participante escolhido e versão lida, para concorrência otimista; details.tarefas.aceitaTarefas e details.tarefas.podeCriarTarefas: marcas escolhidas pelo gestor.",
        "processing": "Verifica pelo acesso da plataforma que quem chama é gestor (gestorPorAcessoPlataforma) e recusa se a versão mudou. Grava as duas marcas só no espaço do módulo; por escolhaGestorNuncaSobrescrita, só o gestor altera essas marcas e nenhum processo automático as substitui. Os campos efetivos são recalculados (participanteNaoConfiguradoAceitaECria), nunca gravados. A mudança fica registrada na auditoria da plataforma.",
        "output": "O participante no novo estado, com a nova versão, as marcas do gestor e as marcas efetivas."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "listaParticipantes",
        "reads": "listarParticipantes.participantes"
      },
      {
        "organism": "formParticipante",
        "reads": "buscarUsuarios.usuarios"
      }
    ],
    "commands": [
      {
        "endpoint": "incluirParticipante",
        "refreshes": []
      },
      {
        "endpoint": "salvarMarcas",
        "refreshes": []
      }
    ],
    "selections": [
      {
        "organism": "listaParticipantes",
        "via": {
          "list": "listarParticipantes.participantes"
        }
      }
    ],
    "journeys": [
      {
        "step": "configurarParticipantes/localizarUsuario",
        "organisms": [
          "formParticipante",
          "listaParticipantes"
        ],
        "endpoints": [
          "buscarUsuarios",
          "listarParticipantes"
        ]
      },
      {
        "step": "configurarParticipantes/incluirParticipante",
        "organisms": [
          "formParticipante"
        ],
        "endpoints": [
          "incluirParticipante"
        ]
      },
      {
        "step": "configurarParticipantes/marcarPermissoes",
        "organisms": [
          "listaParticipantes",
          "formParticipante"
        ],
        "endpoints": [
          "salvarMarcas"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "buscarUsuarios",
        "state": "buscarUsuarios.usuarios",
        "mode": "replace"
      },
      {
        "endpoint": "incluirParticipante",
        "state": "listarParticipantes.participantes",
        "mode": "upsert"
      },
      {
        "endpoint": "salvarMarcas",
        "state": "listarParticipantes.participantes",
        "mode": "upsert"
      },
      {
        "endpoint": "incluirParticipante",
        "state": "buscarUsuarios.usuarios",
        "mode": "remove"
      }
    ]
  }
}
