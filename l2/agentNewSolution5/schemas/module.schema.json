{
  "$id": "https://collab.codes/schemas/agentNewSolution5/module/2026-09-10-ns5-module-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "moduleName",
    "title",
    "userLanguage",
    "productLanguages",
    "defaultLanguage",
    "sourcePrompt",
    "actors",
    "scope"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2026-09-10-ns5-module-v1" },
    "moduleName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "title": { "type": "string", "minLength": 1 },
    "userLanguage": { "type": "string", "minLength": 2 },
    "productLanguages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "defaultLanguage": { "type": "string", "minLength": 2 },
    "sourcePrompt": { "type": "string", "minLength": 1 },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inScope", "outOfScope"],
      "properties": {
        "inScope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "outOfScope": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "kind", "origin", "title", "description"],
      "properties": {
        "actorId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "kind": { "type": "string", "enum": ["internal", "external", "system"] },
        "origin": { "type": "string", "enum": ["named", "inferred"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
