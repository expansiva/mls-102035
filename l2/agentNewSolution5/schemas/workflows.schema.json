{
  "$id": "https://collab.codes/schemas/agentNewSolution5/workflows/2026-09-10-ns5-workflows-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "processes"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "2026-09-10-ns5-workflows-v1" },
    "moduleName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "processes": {
      "type": "array",
      "items": { "$ref": "#/$defs/process" }
    }
  },
  "$defs": {
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processId", "title", "description", "tasks"],
      "properties": {
        "processId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "kind", "next", "description"],
      "properties": {
        "taskId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "kind": { "type": "string", "enum": ["human", "system", "wait"] },
        "actorRef": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "journeyRef": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "stepRef": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "next": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
