{
  "$id": "https://collab.codes/schemas/agentNewSolution5/ontology-entity/2026-09-10-ns5-ontology-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entityId", "fields", "lifecycleStates", "transitions"],
  "properties": {
    "entityId": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    },
    "details": {
      "type": "array",
      "items": { "$ref": "#/$defs/detail" }
    },
    "lifecycleStates": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycleState" }
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "title", "type", "required", "description"],
      "properties": {
        "fieldId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["uuid", "string", "text", "number", "integer", "boolean", "money", "date", "datetime", "json"]
        },
        "required": { "type": "boolean" },
        "enum": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycleState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reachedBy"],
      "properties": {
        "state": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "reachedBy": { "type": "string", "enum": ["actor", "command", "time"] }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transitionId", "from", "to", "by", "description"],
      "properties": {
        "transitionId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "from": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        },
        "to": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "by": { "$ref": "#/$defs/transitionBy" },
        "description": { "type": "string", "minLength": 1 },
        "ruleRefs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        }
      }
    },
    "transitionBy": {
      "oneOf": [
        { "type": "string", "enum": ["system", "time"] },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
        }
      ]
    }
  }
}
