      "persistence": {
        "mode": "crossStoreReference"
      }
    },
    {
      "relationshipId": "consultaProfissional",
      "fromEntity": "Consulta",
      "toEntity": "Profissional",
      "type": "manyToOne",
      "required": true,
      "description": "Cada consulta é realizada por um profissional.",
      "persistence": {
        "mode": "crossStoreReference"
      }
    }
  ]
