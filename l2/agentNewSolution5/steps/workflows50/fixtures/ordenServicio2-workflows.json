{
  "derivedFrom": "ordenServicio2/journeys/*.defs.ts",
  "processes": [
    {
      "processId": "serviceOrderFulfillment",
      "title": "Atencion de una orden de servicio",
      "description": "La orden pasa de recepcion a analisis, decision del cliente, reparacion y entrega.",
      "tasks": [
        {
          "taskId": "receive",
          "kind": "human",
          "actorRef": "recepcionista",
          "journeyRef": "abrirOrdenServicio",
          "stepRef": "createServiceOrder",
          "next": ["analyze"],
          "description": "Recepcion registra la orden abierta y deja el aparato para analisis tecnico."
        },
        {
          "taskId": "analyze",
          "kind": "human",
          "actorRef": "tecnico",
          "journeyRef": "prepararPresupuestoServicio",
          "stepRef": "publishBudget",
          "next": ["decide"],
          "description": "El tecnico publica el presupuesto para que el cliente decida."
        },
        {
          "taskId": "decide",
          "kind": "human",
          "actorRef": "cliente",
          "journeyRef": "consultarYDecidirPresupuesto",
          "stepRef": "decideBudget",
          "next": ["repair"],
          "description": "El cliente aprueba o rechaza el presupuesto."
        },
        {
          "taskId": "repair",
          "kind": "human",
          "actorRef": "tecnico",
          "journeyRef": "repararAparato",
          "stepRef": "markServiceOrderReady",
          "next": ["deliver"],
          "description": "El tecnico repara el aparato autorizado y lo deja listo para entrega."
        },
        {
          "taskId": "deliver",
          "kind": "human",
          "actorRef": "recepcionista",
          "journeyRef": "entregarAparato",
          "stepRef": "recordDelivery",
          "next": [],
          "description": "Recepcion entrega el aparato y cierra la orden."
        }
      ]
    }
  ]
}
